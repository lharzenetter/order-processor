# Copy to .env next to compose.yaml and fill in. Bumping the image tag edits only this file.

# The server image: an exact release version, never latest. The pager bridge installed with
# install-bridge.ps1 has the same version.
SERVER_TAG=0.11.0
# The domain at IONOS. The server is kirbe.<DOMAIN>, whose public A record points at this PC's
# fixed IP on the venue network.
DOMAIN=example.org
# 8 characters with no 0/O or 1/l/I. Written down outside the repo.
PAIRING_CODE=CHANGEME
# Where the server reaches the pager bridge. Leave empty for the default,
# http://host.docker.internal:9186, the bridge on this PC.
BRIDGE_URL=
