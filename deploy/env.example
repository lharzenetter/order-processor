# Copy to .env next to compose.yaml and fill in. Bumping the image tag edits only this file.

# The server image: an exact release version, never latest.
SERVER_TAG=0.4.1
# The domain at IONOS. The server is kirbe.<DOMAIN>, with no public A record.
DOMAIN=example.org
# 8 characters with no 0/O or 1/l/I. Written down outside the repo.
PAIRING_CODE=CHANGEME
# The Pi's fixed IP on the FRITZ!Box network. dnsmasq listens on it.
PI_IP=192.168.178.2
